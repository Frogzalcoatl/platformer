{
    "editor.formatOnSave": true,
    "files.associations": {
        "*.h": "cpp",
        ".clang-format": "yaml",
        ".clangd": "yaml"
    },
    "java.configuration.updateBuildConfiguration": "automatic",
    "java.import.exclusions": [
        "**/android-project/**"
    ],
    "java.diagnostic.filter": [
        "**/android-project/**"
    ]
}