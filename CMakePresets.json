{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 22
  },
  "configurePresets": [
    {
      "name": "android-base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "generator": "Ninja Multi-Config",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "Android",
        "CMAKE_SYSTEM_VERSION": "28",
        "ANDROID_PLATFORM": "android-28",
        "CMAKE_ANDROID_NDK": "$env{ANDROID_NDK_HOME}",
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release;RelWithDebInfo"
      },
      "warnings": {
        "dev": false
      }
    },
    {
      "name": "android-arm64",
      "displayName": "Android (ARM64)",
      "description": "Cross-compile for Android ARM64 physical devices",
      "inherits": "android-base",
      "cacheVariables": {
        "ANDROID_ABI": "arm64-v8a",
        "VCPKG_TARGET_TRIPLET": "arm64-android"
      }
    },
    {
      "name": "android-x86_64",
      "displayName": "Android (x86_64)",
      "description": "Cross-compile for Android Emulators",
      "inherits": "android-base",
      "cacheVariables": {
        "ANDROID_ABI": "x86_64",
        "VCPKG_TARGET_TRIPLET": "x64-android"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "android-arm64-debug",
      "displayName": "Android ARM64 Debug",
      "configurePreset": "android-arm64",
      "configuration": "Debug"
    },
    {
      "name": "android-arm64-release",
      "displayName": "Android ARM64 Release",
      "configurePreset": "android-arm64",
      "configuration": "Release"
    },
    {
      "name": "android-x86_64-debug",
      "displayName": "Android x86_64 Debug",
      "configurePreset": "android-x86_64",
      "configuration": "Debug"
    },
    {
      "name": "android-x86_64-release",
      "displayName": "Android x86_64 Release",
      "configurePreset": "android-x86_64",
      "configuration": "Release"
    }
  ]
}